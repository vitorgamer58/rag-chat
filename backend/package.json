{
  "name": "rag-chat-backend",
  "version": "1.0.0",
  "description": "Backend of a ChatGPT-like chat that answers using RAG over MongoDB Vector Search",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "seed-config": "tsx scripts/seed-config.ts",
    "test": "vitest run",
    "lint-fix": "eslint . --fix && prettier --write .",
    "prettier": "prettier --write ."
  },
  "author": "vitorgamer58",
  "license": "UNLICENSED",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.8",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@mistralai/mistralai": "^2.7.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "mongodb": "^7.6.0",
    "openai": "^7.20.0",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  }
}
