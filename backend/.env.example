# Server
PORT=3000
# Interface to bind. Defaults to 127.0.0.1 (loopback only); production runs behind Apache on 127.0.0.1:5010
HOST=127.0.0.1
NODE_ENV=development
# Comma-separated list of allowed origins for CORS
CORS_ORIGIN=http://localhost:5173
# In production use the exact frontend origin (e.g. https://app.example.com); "*" is rejected at boot

# MongoDB (required, not defined in the Windows environment)
MONGO_URL=
MONGO_DB_NAME=rag

# LLM provider used for completions: KIMI (default) or MISTRAL
LLM_PROVIDER=KIMI
# Timeout for each embedding request (ms)
EMBEDDING_TIMEOUT_MS=30000
# MISTRAL_API_KEY and KIMI_API_KEY are already defined in the Windows user environment variables.
# Only uncomment to override them locally.
# MISTRAL_API_KEY=
# KIMI_API_KEY=
KIMI_MODEL=kimi-k3
KIMI_BASE_URL=https://api.moonshot.ai/v1
# Optional: low | high | max (Kimi K3 default is max)
# KIMI_REASONING_EFFORT=high
MISTRAL_MODEL=mistral-large-latest
MISTRAL_EMBED_MODEL=mistral-embed
LLM_MAX_TOKENS=20048

# Rate limit (per user/fingerprint, counted in the database)
RATE_LIMIT_MAX_MESSAGES=20
RATE_LIMIT_WINDOW_MINUTES=60

# Per-IP limits (requests per window), applied before the per-fingerprint limit above
IP_RATE_LIMIT_WINDOW_SECONDS=60
IP_RATE_LIMIT_GENERAL=120
IP_RATE_LIMIT_WRITE=20
IP_RATE_LIMIT_STREAM=30

# RAG
RAG_VECTOR_INDEX=vector_index
RAG_RETRIEVE_K=6
# Atlas cosine score is (1 + cosine) / 2, so 0.8 is roughly a cosine similarity of 0.6
RAG_SCORE_THRESHOLD=0.8
HISTORY_MAX_MESSAGES=20
MAX_MESSAGE_LENGTH=4000
